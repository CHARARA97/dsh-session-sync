{
  "name": "@charara97/dsh-session-sync",
  "version": "1.1.1",
  "description": "DSH 会话与工作区文件同步：显式推送/取回、单个或全部会话、逐条判断、部分交付、冲突交由人工裁决。",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node tests/engine.test.mjs && node tests/delivery.test.mjs && node tests/client-render.test.mjs"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "会话同步",
    "description": "把 DSH 会话与工作区文件托管在你自己的 GitHub 私有仓库：手动选择 push 或 pull、单个会话或全部会话，全程显示过程，冲突不自动吞掉。"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHARARA97/dsh-session-sync.git"
  },
  "homepage": "https://github.com/CHARARA97/dsh-session-sync#readme",
  "bugs": {
    "url": "https://github.com/CHARARA97/dsh-session-sync/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sync",
    "github",
    "session"
  ],
  "author": "CHARARA97",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib/",
    "locale/",
    "README.md",
    "LICENSE"
  ]
}
